<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tic Tac Toe Offline"
        android:textStyle="bold"
        android:textSize="30dp"
        android:padding="8dp"
        android:layout_margin="8dp" />

    <Button
        android:id="@+id/btnPlayOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="Play Offline"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:textSize="15dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="or"
        android:textStyle="bold"
        android:textSize="30dp"
        android:padding="8dp"
        android:layout_margin="8dp" />
    <Button
        android:id="@+id/btnCreateOnlineGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Game Online"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:textStyle="bold"
        android:textSize="15dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="or"
        android:textStyle="bold"
        android:textSize="30dp"
        android:padding="8dp"
        android:layout_margin="8dp" />

    <EditText
        android:id="@+id/game_id_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="25dp"
        android:textStyle="bold"
        android:inputType="number"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:text="Enter Game ID"/>
    <Button
        android:id="@+id/btnJoinOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Join Game Online"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:textStyle="bold"
        android:textSize="15dp"/>

</LinearLayout>